+@click.pass_context
+def cli(ctx: click.Context, verbose: bool) -> None:
+    """In-development ThinkPad firmware workflow toolkit."""
+    config = Config.load()
+    if verbose:
+        config.verbose = True
+        
+    setup_logging(config.verbose, config.log_file)
+    logger.debug("AutoLoader CLI started")
+    ctx.obj = config
+
