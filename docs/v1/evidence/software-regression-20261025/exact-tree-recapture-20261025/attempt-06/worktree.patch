-_CHIP_LINE = re.compile(
-    r'^\s*Found\s+.+?\s+flash chip\s+["\']([^"\']+)["\']\s+'
-    r'\(\s*([0-9]+)\s+kB\s*,\s*SPI\s*\)\s+on\s+(.+?)\.?\s*$',
-    re.IGNORECASE,
