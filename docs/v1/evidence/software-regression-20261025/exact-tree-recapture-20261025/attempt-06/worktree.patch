+BLKGETSIZE64 = 0x80081272
+DEVICE_IDS = {
+    "request": "LC-REQUEST-RO",
+    "source": "LC-SOURCE-RO",
+    "packages": "LC-PACKAGES-RO",
+    "scratch": "LC-SCRATCH-RW",
+    "output": "LC-OUTPUT-RW",
+    "evidence": "LC-EVIDENCE-RW",
