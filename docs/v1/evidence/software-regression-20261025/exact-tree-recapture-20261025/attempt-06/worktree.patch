+    monkeypatch.setattr(build, "WORKER_OUTPUT", str(output_root))
+    monkeypatch.setattr(build, "WORKER_WORK", str(work_root))
+    monkeypatch.setattr(offline_vm_guest_worker, "SOURCE_MOUNT", source_root)
