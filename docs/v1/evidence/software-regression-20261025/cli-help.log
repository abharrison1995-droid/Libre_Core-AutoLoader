$ python3 -B -m autoloader flash --help
Usage: python -m autoloader flash [OPTIONS]

  Request one exact, interactively approved X200/X220 external SPI write.

Options:
  --profile [t430-1vyrain|x200-libreboot|x220-coreboot]
                                  Allowlisted V1 workflow profile.  [required]
  --checkpoint FILE               Exact staged X200/X220 workflow checkpoint;
                                  arbitrary ROM paths are not accepted.
                                  [required]
  --request FILE                  Current versioned operator setup request
                                  used to reopen the staged plan.  [required]
  --help                          Show this message and exit.
exit 0

$ python3 -B -m autoloader build-usb --help
Usage: python -m autoloader build-usb [OPTIONS]

  Build a candidate ISO through the pinned Archiso contract (Linux only).

Options:
  --source-root DIRECTORY         Absolute clean Git checkout containing this
                                  project.  [required]
  --profile-dir DIRECTORY         Absolute checked-in Archiso profile
                                  directory.  [required]
  --snapshot-lock FILE            Absolute checked-in package snapshot lock.
                                  [required]
  --output-dir DIRECTORY          Absolute existing empty output directory;
                                  files are never overwritten.  [required]
  --work-parent DIRECTORY         Absolute existing directory for an owned
                                  temporary build tree.  [required]
  --network-mode [online|offline]
                                  Use the fixed dated archive or a verified
                                  local package repository.  [required]
  --offline-repository DIRECTORY  Absolute local repository root; required for
                                  offline mode.
  --offline-manifest FILE         Absolute file/hash manifest for the offline
                                  repository.
  --help                          Show this message and exit.
exit 0

